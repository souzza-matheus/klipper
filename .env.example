# Copie para .env e troque todos os valores "troque"

POSTGRES_PASSWORD=troque-senha-do-banco
# Porta do Postgres no seu PC (só localhost), usada pelo backend local
POSTGRES_HOST_PORT=5434

# Evolution API
EVOLUTION_API_KEY=troque-chave-da-evolution
EVOLUTION_PUBLIC_URL=http://SEU_IP_OU_DOMINIO:8080

# Backend
# Porta do backend no seu PC (dentro do Docker ele continua na 8000)
BACKEND_PORT=8002
JWT_SECRET=troque-um-segredo-longo-e-aleatorio
WEBHOOK_SECRET=troque-segredo-do-webhook
SETUP_TOKEN=troque-token-para-cadastrar-barbearias
TIMEZONE=America/Sao_Paulo
# Origens liberadas no CORS (separadas por vírgula). O app nativo não precisa; vazio em produção = nenhuma.
CORS_ORIGINS=
# Deixe false em produção: desliga /dev/simulate, /dev/run-jobs e /docs, e a API não sobe com segredos de exemplo
# (JWT_SECRET com 32+ caracteres; WEBHOOK_SECRET e SETUP_TOKEN com 16+)
DEV_MODE=false
RUN_SCHEDULER=true

# Atendimento com IA (Google Gemini). Sem GEMINI_API_KEY a IA fica desligada e o bot usa só o menu.
# Gere a chave em https://aistudio.google.com/apikey. Nunca coloque a chave em código nem no Git.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
# free: só a barbearia demo (no plano gratuito o Google pode usar o conteúdo); paid: produção
AI_TIER=free
AI_TIMEOUT_SECONDS=15
AI_MAX_TOOL_CALLS=6
AI_HISTORY_MESSAGES=12
# Economia de tokens e conversas fora do tema
AI_MAX_OUTPUT_TOKENS=300
# Raciocínio (cobrado como saída): minimal | low | medium | high (gemini-3.8-flash aceita a partir de low)
AI_THINKING_BUDGET=low
AI_OFFTOPIC_COOLDOWN_MINUTES=60
