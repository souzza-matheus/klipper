# Copie para .env e troque todos os valores "troque"

POSTGRES_PASSWORD=troque-senha-do-banco

# Evolution API
EVOLUTION_API_KEY=troque-chave-da-evolution
EVOLUTION_PUBLIC_URL=http://SEU_IP_OU_DOMINIO:8080

# Backend
# Porta do backend no seu PC (dentro do Docker ele continua na 8000)
BACKEND_PORT=8002
JWT_SECRET=troque-um-segredo-longo-e-aleatorio
WEBHOOK_SECRET=troque-segredo-do-webhook
SETUP_TOKEN=troque-token-para-cadastrar-barbearias
TIMEZONE=America/Sao_Paulo
# Deixe false em produção (desliga /dev/simulate e /dev/run-jobs)
DEV_MODE=false
RUN_SCHEDULER=true
