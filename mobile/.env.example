# Desenvolvimento local (npx expo start): copie para mobile/.env.local (fora do git) e ajuste.
# Os builds do EAS não usam este arquivo: preview e production têm o endereço no eas.json.

# Perfil: development (padrão), preview ou production. Só development e preview têm o modo desenvolvedor
# (7 toques no logo do login para trocar o endereço da API).
EXPO_PUBLIC_APP_PROFILE=development

# Endereço do backend. No celular, use o IP do PC na rede Wi-Fi (não "localhost") ou um túnel com HTTPS:
#   http://192.168.0.10:8002
#   https://nome-do-tunel.trycloudflare.com
# Na web local, vazio = o próprio endereço da página.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8002
