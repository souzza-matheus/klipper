{
  "expo": {
    "name": "SyncServ",
    "slug": "syncserv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.barberbot.admin"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "br.com.barberbot.admin"
    },
    "web": {
      "favicon": "./public/favicon.ico",
      "name": "SyncServ",
      "shortName": "SyncServ",
      "lang": "pt-BR",
      "themeColor": "#0F172A",
      "backgroundColor": "#0F172A",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-asset"
    ]
  }
}
